{
  "name": "amxpixl",
  "productName": "AMxPixl",
  "description": "Pixl Editor: a lightweight, non-destructive image editor.",
  "private": true,
  "license": "MIT",
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "app": "tauri dev",
    "package": "tauri build",
    "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/icons.ps1",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1",
    "sync-public": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-public.ps1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/opentype.js": "^1.3.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "gifenc": "^1.0.3",
    "mediabunny": "^1.62.1",
    "opentype.js": "^1.3.4"
  }
}
